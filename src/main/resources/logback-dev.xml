<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Colorful console appender for development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%green(%d{HH:mm:ss.SSS}) [%blue(%thread)] %highlight(%-5level) %yellow(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- Logger configurations for development -->
    <logger name="art.moodframe" level="DEBUG" />
    <logger name="org.jdbi" level="INFO" />
    <logger name="javafx" level="WARN" />
    
    <!-- Root logger -->
    <root level="DEBUG">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>