<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Footer of the main window: the status message, the memory display (added by the controller in front of the API key
     status) and the API key status -->
<HBox fx:id="statusBar" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="art.moodframe.ui.controller.StatusBarController"
      spacing="10.0" alignment="CENTER_LEFT" styleClass="bg-inset">
    <padding>
        <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
    </padding>

    <!-- Status Message -->
    <Label fx:id="statusLabel" text="Ready" />

    <!-- Spacer -->
    <Region HBox.hgrow="ALWAYS" />

    <!-- Session Info -->
    <Label fx:id="sessionInfoLabel" />

    <!-- API Key Status Indicator: symbol and text share one tooltip on the group -->
    <HBox fx:id="apiKeyStatusGroup" spacing="8.0" alignment="CENTER">
        <FontIcon fx:id="apiKeyStatusIcon" iconLiteral="mdi2k-key" iconSize="16" styleClass="ikonli-font-icon" />
        <Label fx:id="apiKeyStatusLabel" text="No API Key" />
    </HBox>

</HBox>
